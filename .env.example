BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://checker:checker@postgres:5432/checker
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/app/storage

POSTGRES_USER=checker
POSTGRES_PASSWORD=checker
POSTGRES_DB=checker

# Ключи выдаются на https://developers.sber.ru/studio (GigaChat API).
# Укажите CLIENT_ID + CLIENT_SECRET,
# либо готовый ключ авторизации (base64) в GIGACHAT_AUTH_KEY.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_AUTH_KEY=

GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_VERIFY_SSL_CERTS=false

# Токен бота MAX.
MAX_BOT_TOKEN=
# Username бота без @
MAX_BOT_USERNAME=
# Публичный https-домен для webhook
MAX_WEBHOOK_DOMAIN=
# Секрет проверки подписи webhook (необязательно).
MAX_WEBHOOK_SECRET=
BOT_PORT=3000
BACKEND_URL=http://backend:8000

MINIAPP_PORT=80
MINIAPP_PUBLIC_URL=
VITE_API_BASE=/api
